<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.SVGPath?>

<!-- ================= SEGUIMIENTO DE PROYECTOS (conectado a MySQL) ================= -->
<VBox prefHeight="820.0" prefWidth="1072.0" spacing="20.0" styleClass="modulo" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.SeguimientoController">
   <children>

      <!-- Búsqueda -->
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="tarjeta">
         <children>
            <VBox>
               <children>
                  <Label styleClass="tarjeta-titulo" text="Consulta de avance del proyecto" />
                  <Label styleClass="tarjeta-subtitulo" text="Busca por ID, nombre del proyecto o cliente en la base de datos" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="cmbProyectos" prefWidth="250.0" promptText="Seleccionar proyecto..." />
            <TextField fx:id="txtFolioBuscar" onAction="#buscarProyecto" prefWidth="230.0" promptText="ID, nombre o cliente..." />
            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProyecto" styleClass="boton-primario" text="Buscar">
               <graphic>
                  <SVGPath content="M10.5 17 A6.5 6.5 0 1 0 10.5 4 A6.5 6.5 0 1 0 10.5 17 Z M15.5 15.5 L20 20" styleClass="icono-boton" />
               </graphic>
            </Button>
         </children>
      </HBox>

      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="20.0" HBox.hgrow="ALWAYS">
               <children>

                  <!-- Encabezado del proyecto -->
                  <VBox spacing="12.0" styleClass="tarjeta">
                     <children>
                        <HBox alignment="TOP_LEFT" spacing="10.0">
                           <children>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label fx:id="lblFolio" styleClass="texto-tenue" text="PRY-000" />
                                    <Label fx:id="lblCliente" styleClass="texto-grande" text="Selecciona o busca un proyecto" />
                                    <Label fx:id="lblDescripcion" styleClass="texto-tenue" text="Sin proyecto seleccionado" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblEstadoProyecto" text="Sin datos">
                                 <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-neutro" />
                                 </styleClass>
                              </Label>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <ProgressBar fx:id="pbAvance" maxWidth="1.7976931348623157E308" progress="0.0" styleClass="progreso-grande" HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblAvance" styleClass="tarjeta-titulo" text="0 %" />
                           </children>
                        </HBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox maxWidth="1.7976931348623157E308" styleClass="item-lista" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="texto-tenue" text="Fecha de inicio" />
                                    <Label fx:id="lblFechaInicio" styleClass="texto-valor" text="—" />
                                 </children>
                              </VBox>
                              <VBox maxWidth="1.7976931348623157E308" styleClass="item-lista" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="texto-tenue" text="Entrega estimada" />
                                    <Label fx:id="lblFechaEntrega" styleClass="texto-valor" text="—" />
                                 </children>
                              </VBox>
                              <VBox maxWidth="1.7976931348623157E308" styleClass="item-lista" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="texto-tenue" text="Área responsable" />
                                    <Label fx:id="lblAreaActual" styleClass="texto-valor" text="—" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Línea de tiempo -->
                  <VBox spacing="12.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Línea de tiempo del proyecto" />
                        <VBox fx:id="lineaTiempo" spacing="0.0">
                           <children>
                              <HBox spacing="14.0">
                                 <children>
                                    <VBox alignment="TOP_CENTER" minWidth="28.0">
                                       <children>
                                          <StackPane>
                                             <children>
                                                <Circle fx:id="cirPaso1" radius="13.0" styleClass="paso-hecho" />
                                                <SVGPath content="M7.5 12.5 L10.5 15.5 L16.5 9" styleClass="paso-marca" />
                                             </children>
                                          </StackPane>
                                          <Line endY="34.0" styleClass="paso-linea-hecha" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0">
                                             <children>
                                                <Label styleClass="paso-titulo" text="Registro y planeación" />
                                                <Label text="Ventas">
                                                   <styleClass>
                                                      <String fx:value="badge" />
                                                      <String fx:value="badge-neutro" />
                                                   </styleClass>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblFechaPaso1" styleClass="texto-tenue" text="—" />
                                             </children>
                                          </HBox>
                                          <Label fx:id="lblDescPaso1" styleClass="texto-tenue" text="Alta de cliente y definición del alcance del proyecto." wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox spacing="14.0">
                                 <children>
                                    <VBox alignment="TOP_CENTER" minWidth="28.0">
                                       <children>
                                          <StackPane>
                                             <children>
                                                <Circle fx:id="cirPaso2" radius="13.0" styleClass="paso-hecho" />
                                                <SVGPath content="M7.5 12.5 L10.5 15.5 L16.5 9" styleClass="paso-marca" />
                                             </children>
                                          </StackPane>
                                          <Line endY="34.0" styleClass="paso-linea-hecha" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0">
                                             <children>
                                                <Label styleClass="paso-titulo" text="Levantamiento técnico" />
                                                <Label text="Levantamientos">
                                                   <styleClass>
                                                      <String fx:value="badge" />
                                                      <String fx:value="badge-neutro" />
                                                   </styleClass>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblFechaPaso2" styleClass="texto-tenue" text="—" />
                                             </children>
                                          </HBox>
                                          <Label fx:id="lblDescPaso2" styleClass="texto-tenue" text="Visita técnica en sitio y croquis del tendido." wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox spacing="14.0">
                                 <children>
                                    <VBox alignment="TOP_CENTER" minWidth="28.0">
                                       <children>
                                          <StackPane>
                                             <children>
                                                <Circle fx:id="cirPaso3" radius="13.0" styleClass="paso-actual" />
                                                <Circle fill="WHITE" radius="5.0" />
                                             </children>
                                          </StackPane>
                                          <Line endY="34.0" styleClass="paso-linea-pendiente" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0">
                                             <children>
                                                <Label styleClass="paso-titulo" text="Ejecución e instalación" />
                                                <Label text="Instalaciones">
                                                   <styleClass>
                                                      <String fx:value="badge" />
                                                      <String fx:value="badge-neutro" />
                                                   </styleClass>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblEstadoPaso3" text="En curso">
                                                   <styleClass>
                                                      <String fx:value="badge" />
                                                      <String fx:value="badge-info" />
                                                   </styleClass>
                                                </Label>
                                             </children>
                                          </HBox>
                                          <Label fx:id="lblDescPaso3" styleClass="texto-tenue" text="Suministro de material y ejecución de obra." wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox spacing="14.0">
                                 <children>
                                    <VBox alignment="TOP_CENTER" minWidth="28.0">
                                       <children>
                                          <StackPane>
                                             <children>
                                                <Circle fx:id="cirPaso4" radius="13.0" styleClass="paso-pendiente" />
                                                <Label styleClass="texto-tenue" text="4" />
                                             </children>
                                          </StackPane>
                                       </children>
                                    </VBox>
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0">
                                             <children>
                                                <Label styleClass="paso-titulo" text="Revisión final y cierre" />
                                                <Label text="Administración">
                                                   <styleClass>
                                                      <String fx:value="badge" />
                                                      <String fx:value="badge-neutro" />
                                                   </styleClass>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblEstadoPaso4" styleClass="texto-tenue" text="Pendiente" />
                                             </children>
                                          </HBox>
                                          <Label styleClass="paso-pendiente-texto" text="Certificación, pruebas de conectividad y acta de entrega." wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- ===================== PANEL DERECHO ===================== -->
            <VBox minWidth="300.0" prefWidth="320.0" spacing="20.0">
               <children>
                  <VBox spacing="8.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Resumen económico" />
                        <HBox styleClass="resumen-fila">
                           <children>
                              <Label styleClass="texto-tenue" text="Costo del proyecto" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblTotalProyecto" styleClass="texto-valor" text="\$0.00" />
                           </children>
                        </HBox>
                        <HBox styleClass="resumen-fila">
                           <children>
                              <Label styleClass="texto-tenue" text="IVA estimado (16 %)" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblPagado" styleClass="texto-valor" text="\$0.00" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="tarjeta-titulo" text="Total c/IVA" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblSaldo" styleClass="texto-total" text="\$0.00" />
                           </children>
                        </HBox>
                        <ProgressBar fx:id="pbPagos" maxWidth="1.7976931348623157E308" progress="0.5" styleClass="progreso-exito" />
                        <Label fx:id="lblPorcentajePagado" styleClass="texto-tenue" text="Datos calculados desde MySQL" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Contacto del cliente" />
                        <Label fx:id="lblContacto" styleClass="texto-valor" text="—" />
                        <Label fx:id="lblTelefonoContacto" styleClass="texto-tenue" text="Tel: —" />
                        <Label fx:id="lblCorreoContacto" styleClass="texto-tenue" text="Correo: —" />
                        <Label fx:id="lblDireccionContacto" styleClass="texto-tenue" text="Dirección: —" wrapText="true" />
                     </children>
                  </VBox>

                  <VBox spacing="10.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Notas para el cliente" />
                        <TextArea fx:id="txtNotasCliente" minHeight="70.0" prefRowCount="3" promptText="Mensaje con el estado actual del proyecto..." wrapText="true" VBox.vgrow="ALWAYS" />
                        <Button fx:id="btnEnviarActualizacion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#enviarActualizacion" styleClass="boton-primario" text="Enviar actualización al cliente" />
                        <Button fx:id="btnExportar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#exportarReporte" styleClass="boton-secundario" text="Ver resumen del proyecto" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
