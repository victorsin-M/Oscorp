<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" style="-fx-padding: 18;" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.soptec.it.controlador.LogsPruebasController">

    <VBox spacing="10.0" styleClass="card">
        <Label text="Pruebas Controladas de Excepciones, Transacciones y Tolerancia a Fallos" styleClass="section-title" />
        <Label text="Usa estos botones para provocar fallos controlados y verificar que la aplicación muestra mensajes claros, registra el detalle técnico en el archivo de log y continúa funcionando sin cerrarse."
               wrapText="true" styleClass="hint-label" />

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Button text="1. Simular Error de Validación" onAction="#simularErrorValidacion" styleClass="btn-warning" />
            <Button text="2. Simular Rollback Multi-tabla" onAction="#simularRollback" styleClass="btn-warning" />
            <Button text="3. Simular Integridad Referencial" onAction="#simularIntegridad" styleClass="btn-danger" />
            <CheckBox fx:id="chkSimularDesconexion" text="Simular caída de conexión MySQL" onAction="#toggleSimularDesconexion" />
        </HBox>
    </VBox>

    <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <VBox>
                <Label text="Archivo de Log del Sistema" styleClass="section-title" />
                <Label fx:id="lblRutaLog" text="logs/soptec_errores.log" styleClass="hint-label" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Recargar Log" onAction="#cargarLog" styleClass="btn-primary" />
            <Button text="Limpiar Log" onAction="#limpiarLog" styleClass="btn-secondary" />
        </HBox>

        <TextArea fx:id="txtLog" editable="false" wrapText="false"
                  style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;"
                  VBox.vgrow="ALWAYS" />
    </VBox>
</VBox>
